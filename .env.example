# .env.example — compreface-admin. Salin ke .env lalu isi nilai yang ditandai WAJIB. (.env tidak di-commit)
# Nama variabel sama dengan ConfigMap/Secret di k8s/base. JANGAN isi nilai asli di file ini.
# JDBC URL
POSTGRES_URL=jdbc:postgresql://10.14.21.67:5432/biometriks
# URL core
PYTHON_URL=http://compreface-core:3000
# profil upstream
SPRING_PROFILES_ACTIVE=dev
ADMIN_JAVA_OPTS=-XX:MaxRAMPercentage=75.0
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Jakarta
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
SAVE_IMAGES_TO_DB=true
ENABLE_EMAIL_SERVER=false
EMAIL_HOST=smtp.example.internal
EMAIL_FROM=CompreFace <no-reply@example.internal>
# URL publik UI (link email)
FRS_CRUD_HOST=http://localhost:8000
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
LOGGING_LEVEL_COM_EXADEL=INFO
TZ=Asia/Jakarta
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_USER=
# WAJIB — Secret compreface-postgres-credentials
POSTGRES_PASSWORD=
# WAJIB — Secret compreface-admin-secrets
SECURITY_SIGNINGKEY=
# Opsional — Secret compreface-admin-secrets
EMAIL_USERNAME=
# Opsional — Secret compreface-admin-secrets
EMAIL_PASSWORD=
